{
  "name": "dsh-subagent-thincoder",
  "version": "0.1.0",
  "description": "A continuable ThinCoder subagent for DeepSeek Harness: delegates over ACP and reuses the thincoder session slot, so state held in that slot (an approved design token, a review round) survives across delegations.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "subagent",
    "acp",
    "thincoder"
  ],
  "peerDependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "zod": "^4.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
